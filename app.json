{
  "expo": {
    "name": "Projeto Academia",
    "slug": "academia-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "scheme": "academia-app",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#F7F7F8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.academiaapp"
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.academiaapp"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "O Projeto Academia usa a câmera para check-ins de desafio e fotos de progresso.",
          "microphonePermission": "O Projeto Academia usa o microfone ao gravar vídeos curtos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Projeto Academia acessa suas fotos para avatar, feed, progresso e dieta."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#27272A"
        }
      ],
      "expo-video"
    ]
  }
}
